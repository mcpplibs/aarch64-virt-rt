import mcpp;
import std;

// The board facts, emitted as directives.
//
// ⭐ THE SET OF DIRECTIVES THIS EMITS IS THE TEST, NOT THE VALUES.
//
// `riscv-virt-rt` emits three: `link_script`, `runner`, and `link_lib` for the
// C library it is written against. This board is on the zero-libc tier, so it
// emits two — `link_script` and `runner` — and the third is ABSENT rather than
// different.
//
// That is the answer to the question this package was written to ask: are
// "board package" and "C library provider" separable roles? They are. Dropping
// the C library removed a directive and required no new one. Had this board
// needed something `riscv-virt-rt` cannot express, the board-package interface
// would have been incomplete, and that would have been the finding.
//
// ⚠️ ONE THING IS GENUINELY DIFFERENT, AND IT IS CONTENT RATHER THAN INTERFACE.
// With no C library there is no crt0 to select, so this package SHIPS an entry
// point (`src/boot.S`) where the other one picks between picolibc's. That
// changes what is in the package; it changes no directive.
int main() {
    const std::string arch = mcpp::target_arch() ? mcpp::target_arch() : "";
    if (arch != "aarch64") {
        std::cerr << "aarch64-virt-rt is a board package for QEMU's aarch64 "
                     "`virt` machine; it has nothing to say about '"
                  << arch << "'. Build with --target aarch64-none-elf.\n";
        return 1;
    }

    // Where this machine starts and where its RAM is. A relative path resolves
    // against THIS package's root, and the directive reaches the CONSUMER's
    // link — which is the whole reason `link-script` is LinkGlobal.
    mcpp::link_script("virt.ld");

    // ⭐⭐ THE BARE NAME, AND THE ENGINE FINDS IT.
    //
    // This block used to compute an absolute path out of `mcpp::xpkg_dir`, on
    // the grounds — correct when it was written — that a bare name resolves
    // through PATH to a shim dispatching against whichever home owns it.
    //
    // `mcpp.build.runner_lookup` (mcpp #544) removed that: it searches the bin/
    // of a payload declared under `[xlings.workspace]` FIRST, and only then
    // PATH, and reports which directories it searched when the program is
    // nowhere. So naming the program is now both shorter and stricter.
    //
    // ⚠️ AND SINCE mcpp 2026.9.4.2 THAT SEARCH SPANS THE WHOLE GRAPH, which is
    // what makes this work for a CONSUMER rather than only in this checkout.
    // Before it, a bare name resolved only against the ROOT project's
    // declarations — so a consumer of this board had to declare the emulator
    // again, which is the duplication a board package exists to remove. That is
    // why this package's floor is 2026.9.4.2 and not #544's release.
    //
    // ⚠️ AND IT DELETES A FAILURE MODE RATHER THAN MOVING IT. `xpkg_dir`
    // answered empty for anyone building from a checkout, so the old code
    // configured no runner at all and needed an advisory to explain why. There
    // is nothing to explain here: if the emulator is absent, the lookup says so
    // and names where it looked.
    mcpp::runner("qemu-system-aarch64");
    // `virt`'s default CPU does not implement everything an image may use;
    // naming one makes the argument list say which machine needed it.
    for (auto a : {"-machine", "virt", "-cpu", "cortex-a53",
                   "-nographic", "-no-reboot", "-kernel"})
        mcpp::runner(a);

    mcpp::rerun_if_changed("virt.ld");
    mcpp::rerun_if_env_changed("MCPP_TARGET_ARCH");
    return 0;
}
